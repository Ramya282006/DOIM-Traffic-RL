<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <input>
        <net-file value="../../environment/network/research_3x3/grid.net.xml"/>
        <route-files value="north_south_surge.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="1800"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <verbose value="true"/>
        <duration-log.disable value="false"/>
    </report>

</configuration>